# Optional environment variables. This file is a reference, not auto-loaded.
# Set these only if normal executable discovery fails. Never put login tokens here.
# WORKBENCH_PORT=3210
# WORKBENCH_CODEX_BIN=C:\path\to\codex.exe
# WORKBENCH_PYTHON=C:\path\to\python.exe
# WORKBENCH_BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
# WORKBENCH_OCR_ENGINE=tesseract

# Optional image-only Codex binary; must offer gpt-6.1-sol. Does not change listing model.
# WORKBENCH_IMAGE_CODEX_BIN=C:\path\to\codex.exe
# Only if Windows cannot provide a usable short/temporary ASCII tool path.
# WORKBENCH_TOOLS_DIR=C:\Work\shiwu-tools
